{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@smg/codec": ["../../packages/codec/src/index.ts"],
      "@smg/codec/io": ["../../packages/codec/src/io/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
